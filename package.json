{
	"name": "serba-bisa",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:frontend": "bun --env-file=.env run --filter frontend dev",
		"dev:backend": "bun --env-file=.env run --filter @serba-bisa/backend dev",
		"check": "bun run --filter frontend check && bun run --filter @serba-bisa/backend check",
		"test": "bun run --filter @serba-bisa/backend test",
		"build": "bun run --bun --filter frontend build && bun run --filter @serba-bisa/backend build",
		"db:up": "docker compose up -d db",
		"db:stop": "docker compose stop db",
		"db:status": "docker compose ps db",
		"db:generate": "bun --env-file=.env run --filter @serba-bisa/backend db:generate",
		"db:migrate": "bun --env-file=.env run --filter @serba-bisa/backend db:migrate",
		"db:seed": "bun --env-file=.env run --filter @serba-bisa/backend db:seed"
	}
}
