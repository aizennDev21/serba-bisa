{
	"name": "@serba-bisa/backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"check": "tsc --noEmit",
		"test": "bun test",
		"build": "bun build src/index.ts --target=bun --outdir=dist",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.3",
		"drizzle-orm": "^0.44.7",
		"elysia": "^1.4.22",
		"postgres": "^3.4.7"
	},
	"devDependencies": {
		"@types/bun": "^1.3.5",
		"drizzle-kit": "^0.31.7",
		"typescript": "^5.9.3"
	}
}
